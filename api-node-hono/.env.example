API_ORIGIN='http://localhost:3000'
WEB_ORIGIN='http://localhost:4321'
PORT=3000

DB_PROVIDER='neon'
DATABASE_URL='postgresql://user:password@host/db?sslmode=require'

# 'better-auth' (email/password + API keys, self-hosted) or 'clerk' (hosted).
AUTH_PROVIDER='better-auth'
BETTER_AUTH_SECRET='replace-with-a-32-plus-character-random-secret'
# Only used when AUTH_PROVIDER='clerk'.
CLERK_SECRET_KEY='sk_test_replace-me'
CLERK_PUBLISHABLE_KEY='pk_test_replace-me'

EMAIL_PROVIDER='emailit'
EMAILIT_API_KEY='replace-with-your-emailit-api-key'
EMAILIT_FROM='No Reply <noreply@example.com>'

# Object storage for uploaded PDFs. 's3' (any S3-compatible store) or 'memory' (offline dev).
STORAGE_PROVIDER='s3'
S3_BUCKET='my-bucket'
S3_REGION='us-east-1'
S3_ENDPOINT=''
S3_ACCESS_KEY_ID='replace-me'
S3_SECRET_ACCESS_KEY='replace-me'

# AI: embeddings, chat, and PDF OCR (Mistral).
MISTRAL_API_KEY='replace-with-your-mistral-api-key'

LOG_LEVEL='info'

{
  "name": "@you/npm-cli-base",
  "version": "0.0.0",
  "description": "CLI template — TypeScript on bun, oxlint + oxfmt + tsc checks, npm-ready",
  "license": "MIT",
  "bin": {
    "cli-name": "src/cli.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "scripts": {
    "check": "oxlint && oxfmt --check && tsc --noEmit",
    "check:fix": "oxlint --fix && oxfmt --write",
    "test": "vitest run",
    "cli": "bun run src/cli.ts"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "bun-types": "^1.4.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "bun": ">=1.4"
  }
}

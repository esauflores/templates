# Copy to .env.local and fill in. Only VITE_* vars reach the browser bundle.
# Validated in src/env.ts.

# Base URL of the CRUD API. Leave unset for the in-memory demo (seed data);
# set it and every useCrud mutation persists via src/lib/api.ts.
# VITE_API_URL=https://api.example.com

# Sentry DSN — unset disables client error/perf reporting (src/lib/sentry.ts).
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
